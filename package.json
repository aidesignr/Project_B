    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.4",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
